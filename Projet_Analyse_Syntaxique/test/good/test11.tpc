
// Écrit en minuscule sur la sortie standard
char to_lower(char c) {
    if (c >= 'A' && c <= 'Z')
        return c + ('a' - 'A');
    else
        return c;
}

int main(void){
	static int a;
	static char c;
	a = 0;
	while(a < 64){
		c = getchar();
		c = to_lower(c);
		putchar(c);
		a = a + 1;
	}
	return 0;
}

