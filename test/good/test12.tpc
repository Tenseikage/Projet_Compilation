

//Alternance entre les lettres minuscule et majuscules
char to_lower(char c) {
    if (c >= 'A' && c <= 'Z')
        return c + ('a' - 'A');
    else
        return c;
}

char to_upper(char c) {
    if (c >= 'a' && c <= 'z')
        return c - ('a' - 'A');
    else
        return c;
}

int main(void){
	static int a;
	static char c;
	a = 0;
	while(a < 64){
		c = getchar();
		if (!(a % 2)){
			c = to_lower(c);
		} else {
			c = to_upper(c);
		}
		putchar(c);
		a = a + 1;
	}
	return 0;
}

