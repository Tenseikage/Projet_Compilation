
// Écrit en majuscule sur la sortie standard
char to_upper(char c) {
    if (c >= 'a' && c <= 'z')
        return c - ('a' - 'A');
    else
        return c;
}

int main(void){
	static int a;
	static char c;
	a = 0;
	while(a < 64){
		c = getchar();
		c = to_upper(c);
		putchar(c);
		a = a + 1;
	}
	return 0;
}

