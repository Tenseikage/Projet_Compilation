

// Calcul pgcd et ppcm
int pgcd(int a, int b) {
	int tmp;
    while (b != 0) {
		tmp = b;
        b = a % b;
        a = tmp;
    }
    return a;
}

int ppcm(int a, int b) {
    if (a == 0 || b == 0){
		return 0;
	} else {
		return (a * b) / pgcd(a, b);
	}
}

int main(void) {
    static int a;
	static int b;
	static int result;
	a = getint();
	b = getint();
	result = ppcm(a,b);
	putint(pgcd(a,b));
	putchar('\n');
	putint(result);
	putchar('\n');
    return 0;
}